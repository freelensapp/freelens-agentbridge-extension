{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": [
    // analyzed as an entry instead of through the vite/electron-vite plugins,
    // see the plugin note below
    "electron.vite.config.js",
    "out/{main,renderer}/index.js!",
    "src/main/index.ts",
    "src/renderer/index.tsx",
    "src/**/*.{test,spec}.{ts,tsx}",
    "test/**/*.{ts,tsx}"
  ],
  "project": ["*.{js,mjs,ts}", "out/**/*.js!", "src/**/*.{ts,tsx}"],

  "ignoreBinaries": [
    "electron-rebuild",
    "yq",
    // used via shell in read-frontmatter tests
    "mkfifo"
  ],
  "ignoreDependencies": [
    // used as vite plugin
    "@babel/plugin-proposal-decorators",
    // provided by the Electron runtime in the Freelens host
    "electron",
    // bundled into out/renderer by the production build, so the production
    // graph (out/main entry) never sees the import
    "monaco-editor",
    "@monaco-editor/react"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  // knip loads plugin configs through its own CJS transpile, which cannot call
  // ESM-only @vitejs/plugin-react, so loading electron.vite.config.js fails and
  // knip >= 6.35.1 exits with code 2. Both plugins must be disabled: the
  // electron-vite plugin auto-detects the same config file on its own.
  // https://knip.dev/reference/known-issues
  "vite": false,
  "electron-vite": false,

  "exclude": ["exports"]
}
